# 生产环境配置示例
# 复制此文件为 .env.production 并填入实际值

# API配置
VITE_API_BASE_URL=https://api.therapy-system.com
VITE_API_TIMEOUT=30000

# 认证配置
VITE_AUTH_DOMAIN=auth.therapy-system.com
VITE_AUTH_CLIENT_ID=your-client-id

# 安全配置
VITE_ENCRYPTION_ENABLED=true
VITE_SECURITY_LOG_LEVEL=ERROR

# 文件上传配置
VITE_MAX_FILE_SIZE=10485760
VITE_ALLOWED_FILE_TYPES=image/jpeg,image/png,image/gif,video/mp4,video/webm

# 水印配置
VITE_WATERMARK_ENABLED=true
VITE_WATERMARK_LOGO_URL=https://cdn.therapy-system.com/logo.png

# 地理位置服务
VITE_GEOLOCATION_API_KEY=your-geolocation-api-key

# 监控配置
VITE_SENTRY_DSN=https://sentry.io/your-project-dsn
VITE_ANALYTICS_ID=your-analytics-id

# PWA配置
VITE_PWA_ENABLED=true
VITE_PWA_START_URL=/

# 功能开关
VITE_FEATURE_PROOF_GENERATION=true
VITE_FEATURE_DIGITAL_SIGNATURE=true
VITE_FEATURE_OFFLINE_MODE=true

# 其他配置
VITE_APP_NAME=治疗师治疗记录系统
VITE_APP_VERSION=1.0.0
VITE_SUPPORT_EMAIL=support@therapy-system.com